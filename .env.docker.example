# Copier ce fichier en ".env" (à cette même racine, à côté de
# docker-compose.yml) et remplir de vraies valeurs.

POSTGRES_USER=gestion_academique_user
POSTGRES_PASSWORD=
POSTGRES_DB=gestion_inscription_paiement

JWT_SECRET=

# Doit être EXACTEMENT la même valeur que CLE_API_INTEGRATION dans le
# .env.docker du projet académique — c'est cette clé qui identifie ce
# logiciel auprès de l'académique.
CLE_API_ACADEMIQUE=
