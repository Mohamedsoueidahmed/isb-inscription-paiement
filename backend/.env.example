# Base de données PROPRE à ce logiciel — jamais la même que celle du
# système académique. Créez une nouvelle base PostgreSQL dédiée, par
# exemple "gestion_inscription_paiement".
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/gestion_inscription_paiement?schema=public"

# Secret pour les jetons de connexion des comptables/caissiers de CE
# logiciel — différent du secret JWT du système académique.
JWT_SECRET="choisissez-une-longue-chaine-aleatoire-ici"

NODE_ENV="development"

# --- Communication avec le système académique existant ---

# L'adresse où tourne le serveur académique (isb.note), déjà existant.
URL_API_ACADEMIQUE="http://localhost:3000/api"

# La MÊME clé que celle configurée côté académique dans sa variable
# CLE_API_INTEGRATION (fichier .env du projet académique) — les deux
# valeurs doivent être identiques, mot pour mot.
CLE_API_ACADEMIQUE="doit-etre-identique-a-CLE_API_INTEGRATION-cote-academique"
